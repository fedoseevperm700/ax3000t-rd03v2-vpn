# --- AmneziaWG 3.1 (модуль ядра — только внутри прошивки) ---
CONFIG_PACKAGE_kmod-amneziawg=y
CONFIG_PACKAGE_amneziawg-tools=y
CONFIG_PACKAGE_luci-proto-amneziawg=y

# --- Podkop и sing-box — ОТДЕЛЬНЫМИ пакетами (=m), не в образе ---
# sing-box весит ~13 МБ. Внутри образа он раздувал initramfs до 29 МБ, и
# временной системе в RAM не хватало памяти принять основную прошивку.
# Это обычные программы, не модули ядра: ставятся после первой загрузки
# из .apk, выложенных в том же релизе (см. README).
CONFIG_PACKAGE_sing-box=m
CONFIG_PACKAGE_podkop=m
CONFIG_PACKAGE_luci-app-podkop=m
# Podkop работает через TPROXY и не использует Tailscale и gVisor (TUN-стек).
# CONFIG_SINGBOX_WITH_TAILSCALE is not set
# CONFIG_SINGBOX_WITH_GVISOR is not set

# Мелкие зависимости Podkop/sing-box — в образе, чтобы при установке
# хватало четырёх .apk из релиза и не нужен был интернет-репозиторий.
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tun=y

# --- Русский интерфейс LuCI ---
# Пакеты luci-i18n-*-ru скрытые: они включаются сами для каждого
# установленного приложения LuCI, когда выбран язык ru.
CONFIG_LUCI_LANG_ru=y

# --- Мелочи для диагностики ---
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_htop=y
