#!/bin/sh
# Ставит Podkop и sing-box из архива podkop-packages.tar.gz того же релиза.
# Использование: скопировать архив в /tmp и выполнить
#   podkop-install /tmp/podkop-packages.tar.gz
set -e
ARCHIVE="${1:-/tmp/podkop-packages.tar.gz}"
[ -f "$ARCHIVE" ] || { echo "Нет файла $ARCHIVE"; exit 1; }
DIR=/tmp/podkop-apk
rm -rf "$DIR"; mkdir -p "$DIR"
tar xzf "$ARCHIVE" -C "$DIR"
apk add --no-network --allow-untrusted "$DIR"/*.apk
rm -rf "$DIR"
# sing-box: более частая сборка мусора Go, меньше пиков памяти (в RAM ~180 МБ)
F=/etc/init.d/sing-box
grep -q GOMEMLIMIT $F || sed -i 's/^\tprocd_set_param respawn$/&\n\tprocd_set_param env GOGC=50 GOMEMLIMIT=32MiB/' $F
grep -q GOMEMLIMIT $F || echo "Внимание: не удалось добавить GOMEMLIMIT в $F"
echo "Готово. Обновите страницу LuCI (Ctrl+F5): появится раздел «Службы → Podkop»."
